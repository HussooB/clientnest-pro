generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Hint: Remember to append url = env("DATABASE_URL") and directUrl = env("DIRECT_URL") here if updating on Render!
}

enum Role {
  Admin
  Finance
  Support
  Sales
}

enum ClientStatus {
  Prospect
  Active
  OnHold
  Churned
}

enum ContactType {
  Technical
  Billing
  Executive
}

enum LeadStage {
  New
  Contacted
  ProposalSent
  Negotiation
  Won
  Lost
}

enum LostReason {
  Price
  Competitor
  Timing
  NoBudget
  Other
}

enum LeadSource {
  Referral
  Website
  Outbound
  ColdCall
}

enum LicenseType {
  Perpetual
  Subscription
  Leased
}

enum InvoiceStatus {
  Draft
  Sent
  PartiallyPaid
  Paid
  Overdue
}

enum PaymentCategory {
  Hosting
  Maintenance
  Upgrade
  License
}

enum HostingCycle {
  Monthly
  Yearly
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

enum ContractStatus {
  Draft
  Active
  Expired
  Terminated
}

enum FeatureRequestStatus {
  Requested
  Approved
  InProgress
  Delivered
  Rejected
}

enum FeatureCategory {
  CustomDevelopment
  OutOfScope
  BugFix
  Enhancement
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(Sales)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs       AuditLog[]
  clients         Client[]     @relation("AccountOwner")
  payments        Payment[]
  creditNotes     CreditNote[]
  assignedTickets Ticket[]     
  timeLogs        TimeLog[]    
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Client {
  id              String       @id @default(cuid())
  companyName     String       @unique
  taxId           String?
  billingAddress  String?
  industryType    String?
  status          ClientStatus @default(Prospect)
  accountOwnerId  String?
  taxRatePct      Float        @default(0)
  hostingFeeAmount Float?
  hostingCycle    HostingCycle?
  amcEndDate      DateTime?
  amcIncludedHours Int?
  hourlyRate      Float?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accountOwner    User?        @relation("AccountOwner", fields: [accountOwnerId], references: [id])
  contacts        Contact[]
  licenses        License[]
  invoices        Invoice[]
  tickets         Ticket[]     
  contracts       Contract[]
  featureRequests FeatureRequest[] // ✅ FIXED: Added "Request[]"

  @@index([companyName])
}

model Contact {
  id         String      @id @default(cuid())
  name       String
  email      String?
  phone      String?
  contactType ContactType
  notifyEmail Boolean    @default(true)
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String      @id @default(cuid())
  companyName     String
  contactName     String?
  email           String?
  phone           String?
  source          LeadSource  @default(Website)
  estimatedValue  Float?
  stage           LeadStage   @default(New)
  lostReason      LostReason?
  convertedClientId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([companyName])
}

model Product {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  basePrice   Float
  licenses    License[]
  featureRequests FeatureRequest[]
}

model License {
  id        String      @id @default(cuid())
  clientId  String
  productId String
  type      LicenseType
  startDate DateTime
  endDate   DateTime?
  seats     Int?

  client    Client  @relation(fields: [clientId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Float
  taxRatePct    Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float
  status        InvoiceStatus @default(Draft)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id])
  items         InvoiceItem[] 
  payments      Payment[]
  creditNotes   CreditNote[]

  @@index([clientId])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  qty         Float
  unitPrice   Float
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
}

model Payment {
  id           String          @id @default(cuid())
  invoiceId    String
  amount       Float
  paymentDate  DateTime        @default(now())
  method       String?
  category     PaymentCategory
  notes        String?
  createdById  String
  createdAt    DateTime        @default(now())

  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
}

model CreditNote {
  id          String     @id @default(cuid())
  invoiceId   String
  amount      Float
  reason      String
  createdById String
  createdAt   DateTime   @default(now())

  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id])
}

model Ticket {
  id              String          @id @default(cuid())
  ref             String          @unique
  clientId        String
  subject         String
  description     String?
  priority        TicketPriority  @default(Medium)
  status          TicketStatus    @default(Open)
  assignedToId    String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  client          Client          @relation(fields: [clientId], references: [id])
  assignedTo      User?           @relation(fields: [assignedToId], references: [id])
  timeLogs        TimeLog[]
  attachments     Attachment[]
  
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model TimeLog {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  minutes     Int
  note        String?
  createdAt   DateTime @default(now())
  
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([ticketId])
}

model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  name        String
  size        Int      
  uploadedBy  String
  createdAt   DateTime @default(now())
  
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
}

model Contract {
  id            String         @id @default(cuid())
  clientId      String
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  autoRenewal   Boolean        @default(false)
  renewalPeriod String?        
  value         Float?
  status        ContractStatus @default(Active)
  fileUrl       String?
  fileName      String?
  fileType      String?
  fileSize      Int?           
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([endDate])
  @@index([status])
}

model FeatureRequest {
  id            String               @id @default(cuid())
  clientId      String
  productId     String?
  title         String
  description   String
  category      FeatureCategory
  status        FeatureRequestStatus @default(Requested)
  estimatedCost Float?
  roadmapItem   String?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  client        Client               @relation(fields: [clientId], references: [id])
  product       Product?             @relation(fields: [productId], references: [id])

  @@index([clientId])
  @@index([status])
}