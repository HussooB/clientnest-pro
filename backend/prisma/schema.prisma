generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Finance
  Support
  Sales
}

enum ClientStatus {
  Prospect
  Active
  OnHold
  Churned
}

enum ContactType {
  Technical
  Billing
  Executive
}

enum LeadStage {
  New
  Contacted
  ProposalSent
  Negotiation
  Won
  Lost
}

enum LostReason {
  Price
  Competitor
  Timing
  NoBudget
  Other
}

enum LeadSource {
  Referral
  Website
  Outbound
}

enum LicenseType {
  Perpetual
  Subscription
  Leased
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(Sales)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]
  clients      Client[]   @relation("AccountOwner")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Client {
  id              String       @id @default(cuid())
  companyName     String
  taxId           String?
  billingAddress  String?
  industryType    String?
  status          ClientStatus @default(Prospect)
  accountOwnerId  String?
  taxRatePct      Float        @default(0)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accountOwner    User?        @relation("AccountOwner", fields: [accountOwnerId], references: [id])
  contacts        Contact[]
  licenses        License[]

  @@index([companyName])
}

model Contact {
  id         String      @id @default(cuid())
  name       String
  email      String?
  phone      String?
  contactType ContactType
  notifyEmail Boolean    @default(true)
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String      @id @default(cuid())
  companyName     String
  contactName     String?
  email           String?
  phone           String?
  source          LeadSource  @default(Website)
  estimatedValue  Float?
  stage           LeadStage   @default(New)
  lostReason      LostReason?
  convertedClientId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([companyName])
}

model Product {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  basePrice   Float
  licenses    License[]
}

model License {
  id        String      @id @default(cuid())
  clientId  String
  productId String
  type      LicenseType
  startDate DateTime
  endDate   DateTime?
  seats     Int?

  client    Client  @relation(fields: [clientId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}
